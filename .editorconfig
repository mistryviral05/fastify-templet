# EditorConfig keeps indentation and line endings consistent across editors.
# Docs: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{ts,tsx,js,mjs,cjs,json,jsonc}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 4

[*.md]
# Markdown uses trailing spaces for hard line breaks
trim_trailing_whitespace = false
max_line_length = off

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

[{package.json,bun.lock,*.lock}]
indent_size = 2
insert_final_newline = true

[*.{env,env.*}]
trim_trailing_whitespace = true
insert_final_newline = true
